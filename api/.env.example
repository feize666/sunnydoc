# sunnydoc 后端环境变量示例
# 复制为 .env 并填入实际值；不配置则自动降级（LLM→规则回答，Embedding→纯关键词检索）

# ---- LLM（阿里云百炼，OpenAI 兼容接口）----
# 模型选择：qwen-plus（稳定可用）/ qwen-max（更强、更贵）/ qwen-turbo（最便宜）
# ⚠️ 不要填账号未开通的型号（如 qwen3-max 部分账号会 404「Model not exist」）——
#    那会让 AI 问答静默降级为规则拼接。填好务必点设置页「测试连接」确认 200。
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# ---- Embedding（阿里云百炼）----
# 模型选择：text-embedding-v4（最新，多语言向量，检索效果较 V3 提升 15-40%）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# ---- PostgreSQL + pgvector（可选，未配置则降级为 JSON 文件存储）----
# 示例：postgresql://user:pass@localhost:5432/sunnydoc
DATABASE_URL=
