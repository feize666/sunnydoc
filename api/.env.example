# sunnydoc 后端环境变量示例
# 复制为 .env 并填入实际值；不配置则自动降级（LLM→规则回答，Embedding→纯关键词检索）

# ---- LLM（阿里云百炼，OpenAI 兼容接口）----
# 模型选择：qwen3-max（旗舰，复杂推理最强）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-max

# ---- Embedding（阿里云百炼）----
# 模型选择：text-embedding-v4（最新，多语言向量，检索效果较 V3 提升 15-40%）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
